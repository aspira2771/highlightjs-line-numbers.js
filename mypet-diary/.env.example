# Copy this file to `.env` and fill in values.
#   cp .env.example .env
#
# `.env` is gitignored — secrets never get committed.
# After editing .env, restart the dev server (npm run dev).

# --- AI character (server-side only, never shipped to the browser) ---
# Used by the proxy in vite.character-proxy.ts.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# --- Backend & social login (Supabase) ---
# Optional: without these the app runs in local "guest" mode.
# Create a project at https://supabase.com, then enable Google & Kakao
# providers under Authentication → Providers. These are PUBLIC (anon) values,
# safe to expose to the browser — RLS protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
